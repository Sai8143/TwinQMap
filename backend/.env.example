# TwinQ-Map Environment Configurations
PROJECT_NAME=TwinQ-Map
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security Settings
JWT_SECRET=supersecretjwtkeythatshouldbechangedinproduction123!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=twinq_map

# Operation Mode
# "simulation" or "real"
OPERATION_MODE=real

# Quantum Provider SDK API Tokens
IBM_QUANTUM_TOKEN=
IONQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AZURE_QUANTUM_CONNECTION_STRING=
RIGETTI_API_KEY=
